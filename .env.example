# Provider must implement POST /responses, not only /chat/completions.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Required: choose a model available on your endpoint.
OPENAI_MODEL=
SCRIPTOR_DB=data/scriptor.db
SCRIPTOR_TIMEOUT=180
SCRIPTOR_MAX_OUTPUT_TOKENS=12000
# false explicitly selects JSON text + local validation, still over Responses.
SCRIPTOR_STRUCTURED_OUTPUT=true
# Character budget, not a token estimate.
SCRIPTOR_CONTEXT_CHARS=28000
