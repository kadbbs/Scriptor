# openai uses POST /responses; anthropic uses POST /v1/messages.
SCRIPTOR_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Required: choose a model available on your endpoint.
OPENAI_MODEL=
# Used only when SCRIPTOR_PROVIDER=anthropic. Base URL excludes /v1/messages.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=

SCRIPTOR_DB=data/scriptor.db
SCRIPTOR_TIMEOUT=180
SCRIPTOR_MAX_OUTPUT_TOKENS=12000
# false explicitly selects JSON text + local validation on the selected provider.
SCRIPTOR_STRUCTURED_OUTPUT=true
# Character budget, not a token estimate.
SCRIPTOR_CONTEXT_CHARS=28000
