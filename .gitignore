# --- 核心安全：绝对不要上传 ---
# 环境变量（包含 API 密钥）
.env
.env.*
!.env.example
.venv/
data/
*.db
*.db-shm
*.db-wal
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# --- Python 垃圾文件 ---
# 字节码缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境（每个人本地生成，不需要上传）
myenv/
venv/
ENV/
env/

# --- 项目数据 ---
# 书籍数据（体积大，且包含你的创作内容，建议本地保存）
# 如果你想备份书籍，可以注释掉下面这行，但推荐忽略
books/

# --- IDE 配置 ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- 系统文件 ---
.DS_Store
Thumbs.db
